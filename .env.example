# AI is opt-in. Keep it disabled until a real server-side key and model are set.
AI_ENABLED=false
SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
SOCLAAS_API_KEY=
SOCLAAS_MODEL=

# Deployments may tighten these limits, but must not exceed these values.
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=800
AI_MAX_IN_FLIGHT=5
AI_RATE_PER_MINUTE=5
AI_RATE_PER_HOUR=30
