# AI is opt-in. Keep it disabled until a real server-side key and model are set.
AI_ENABLED=true
SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
SOCLAAS_API_KEY=api-key-here
SOCLAAS_MODEL=qwen3.8:27b

# Deployments may tighten these limits, but must not exceed these values.
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=800
AI_MAX_IN_FLIGHT=5
AI_RATE_PER_MINUTE=5
AI_RATE_PER_HOUR=30

SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
SUPABASE_SSL_ROOT_CERT=ssl-cert-path-here
SESSION_COOKIE_SECURE=false
SPRING_DATASOURCE_USERNAME=facilityflow_app.user
SPRING_DATASOURCE_PASSWORD=password-here
SUPABASE_SSL_ROOT_CERT=ssl-cert-path-here